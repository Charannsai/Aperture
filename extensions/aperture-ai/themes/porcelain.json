      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#9c6e34"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#8b6535"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
