  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7a8273",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#97495f"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#59734e"
      }
    },
